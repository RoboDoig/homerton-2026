# docfx build output
_site/
api/**/*.yml
api/.manifest
log.txt

# Bonsai environments. Unanchored so they match a .bonsai folder at any depth,
# not just the repository root. Bonsai.config, NuGet.config and the Setup scripts
# are committed — the Setup script regenerates everything ignored here.
*.exe
*.exe.*
Packages/

# Per-user Bonsai editor window state. Visualizer layouts (*.layout) are kept
# deliberately, so the workflows open with the right visualizers.
*.editor

# Build output from Bonsai script extensions
Extensions/bin/
Extensions/obj/

*.bonsai.layout.bak

# Personal prep notes — kept local, and excluded from the docfx build in case
# one is ever committed anyway.
*-notes.md

# Editors / OS
.vs/
.vscode/
.idea/
Thumbs.db
Desktop.ini
*~
